{
    // -----------------------------------------
    //              Terminal
    // -----------------------------------------
    "terminal.integrated.env.linux": {
        "STARSHIP_CONFIG": "/home/nobolde/.config/pure-preset.toml",
        "SPACESHIP_PROMPT_ADD_NEWLINE": "false"
    },
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "bash",
            "args": ["--rcfile","~/coding/config_files/vscode/vscoderc"],
            "icon": "terminal-bash"
        }
    },
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.fontFamily": "'FiraCode Nerd Font Mono'",
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.shellIntegration.enabled": false,
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",



    // -----------------------------------------
    //              IDE settings
    // -----------------------------------------
    "settingsSync.ignoredSettings": [
        "workbench.colorTheme"
    ],
    "extensions.ignoreRecommendations": true,
    "editor.wordWrap": "on",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "editor.minimap.enabled": false,
    "workbench.sideBar.location": "right",
    "chat.viewSessions.orientation": "stacked",
    


    // -----------------------------------------
    //              Copilot Shit
    // -----------------------------------------
    "github.copilot.enable": {
        "*": false,
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "[cpp]": {
        "editor.wordBasedSuggestions": "off",
        "editor.semanticHighlighting.enabled": true,
        "editor.stickyScroll.defaultModel": "foldingProviderModel",
        "editor.suggest.insertMode": "replace"
    },
    


    // -----------------------------------------
    //              Security
    // -----------------------------------------
    "security.workspace.trust.untrustedFiles": "open",
    
    

    // -----------------------------------------
    //              Git
    // -----------------------------------------
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.mergeEditor": true,
    "git.openRepositoryInParentFolders": "never",
    
    
    
    // -----------------------------------------
    //              Python
    // -----------------------------------------
    "python.createEnvironment.trigger": "off",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoIndent": true,
    "python.analysis.displayEnglishDiagnostics": true,
    "jupyter.askForKernelRestart": false,



    // -----------------------------------------
    //              Aesthetics
    // -----------------------------------------
    "workbench.colorTheme": "Ayu Dark Bordered",
    "workbench.colorCustomizations": {
        "[Ayu Dark Bordered]": {
            "sideBar.foreground": "#7b8396",
            "sideBarTitle.foreground": "#7b8396",
            "sideBarSectionHeader.foreground": "#646d83"
        },
        "[Quiet Light]": {
            "editor.background":"#f5eef3",
            "sideBar.background":"#f5eef3",
            "editorGroupHeader.tabsBackground":"#f3f3f3",
        }
    },
    // "editor.tokenColorCustomizations": {
    //     "[Quiet Light]": {
    //     "comments": ""
    //     }
    // },
    
}